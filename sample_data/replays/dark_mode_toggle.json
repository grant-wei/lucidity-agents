 "changed_files": {
  "static/style.css": "body {\n  box-sizing: border-box;\n  max-width: 600px;\n  margin: 40px auto;\n  padding: 0 16px;\n  background: #ffffff;\n  color: #111111;\n  font-family: sans-serif;\n}\n\nh1 { font-size: 24px; }\n\nbutton {\n  padding: 0.5em 0.75em;\n  font: inherit;\n  cursor: pointer;\n}\n\nbutton:focus-visible {\n  outline: 3px solid #1769aa;\n  outline-offset: 2px;\n}\n\nli {\n  margin: 0.4em 0;\n  padding: 0.4em;\n}\n\nbody.dark-mode {\n  background: #121212;\n  color: #f1f1f1;\n}\n\nbody.dark-mode li {\n  background: #242424;\n  color: #f1f1f1;\n}\n",
  "templates/index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Notes</title>\n  <link rel=\"stylesheet\" href=\"{{ url_for('static', filename='style.css') }}\">\n</head>\n<body>\n  <h1>Notes</h1>\n  <button id=\"dark-mode-toggle\" type=\"button\" aria-pressed=\"false\">Dark mode</button>\n  <ul>\n    {% for n in notes %}<li>{{ n }}</li>{% endfor %}\n  </ul>\n  <script>\n    const darkModeToggle = document.getElementById('dark-mode-toggle');\n    const darkModePreference = localStorage.getItem('dark-mode');\n\n    function setDarkMode(enabled) {\n      document.body.classList.toggle('dark-mode', enabled);\n      darkModeToggle.setAttribute('aria-pressed', String(enabled));\n    }\n\n    setDarkMode(darkModePreference === 'enabled');\n\n    darkModeToggle.addEventListener('click', () => {\n      const enabled = !document.body.classList.contains('dark-mode');\n      setDarkMode(enabled);\n      localStorage.setItem('dark-mode', enabled ? 'enabled' : 'disabled');\n    });\n  </script>\n</body>\n</html>\n"
 },
